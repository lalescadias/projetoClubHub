generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  CAR
  VAN
  BUS
  MOTORCYCLE
  OTHER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  UNAVAILABLE
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

enum ClubRole {
  ADMIN
  MEMBER
}

enum UserRole {
  SUPER_ADMIN
  STANDARD
}

model Club {
  id          String       @id @default(uuid())
  name        String       @db.VarChar(120)
  slug        String       @unique @db.VarChar(80)
  themeColor  String       @default("#1D4635") @db.VarChar(7)
  memberships Membership[]
  vehicles    Vehicle[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id           String       @id @default(uuid())
  name         String       @db.VarChar(120)
  email        String       @unique @db.VarChar(180)
  passwordHash String
  role         UserRole     @default(STANDARD)
  isActive     Boolean      @default(true)
  memberships  Membership[]
  dismissedNotifications NotificationDismissal[]
  vehiclesCreated         Vehicle[]              @relation("VehicleCreatedBy")
  vehiclesUpdated         Vehicle[]              @relation("VehicleUpdatedBy")
  usagesCreated           VehicleUsage[]         @relation("VehicleUsageCreatedBy")
  usagesUpdated           VehicleUsage[]         @relation("VehicleUsageUpdatedBy")
  revisionsCreated        VehicleRevision[]      @relation("VehicleRevisionCreatedBy")
  revisionsUpdated        VehicleRevision[]      @relation("VehicleRevisionUpdatedBy")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Membership {
  id                       String                    @id @default(uuid())
  role                     ClubRole                  @default(MEMBER)
  isActive                 Boolean                   @default(true)
  userId                   String
  clubId                   String
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  club                     Club                      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([userId, clubId])
  @@index([clubId, isActive])
}

model NotificationDismissal {
  id             String     @id @default(uuid())
  notificationId String     @db.VarChar(240)
  userId         String
  clubId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@unique([userId, clubId, notificationId])
  @@index([userId, clubId])
}

model Vehicle {
  id              String        @id @default(uuid())
  plate           String        @db.VarChar(20)
  make            String        @db.VarChar(80)
  model           String        @db.VarChar(80)
  version         String?       @db.VarChar(100)
  year            Int
  currentMileage  Int           @default(0)
  fuelType        FuelType      @default(OTHER)
  type            VehicleType
  status          VehicleStatus @default(ACTIVE)
  inspectionDate  DateTime?     @db.Date
  insuranceDate   DateTime?     @db.Date
  notes           String?       @db.Text
  clubId          String
  club            Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?         @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?         @relation("VehicleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  usages          VehicleUsage[]
  revisions       VehicleRevision[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([clubId, plate])
  @@index([clubId, status])
  @@index([clubId, make, model])
  @@index([createdById])
}

model VehicleRevision {
  id                      String   @id @default(uuid())
  vehicleId               String
  vehicle                 Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  revisionDate            DateTime @db.Date
  mileage                 Int
  description             String   @db.VarChar(240)
  servicesPerformed       String   @db.Text
  workshop                String?  @db.VarChar(160)
  cost                    Decimal? @db.Decimal(12, 2)
  nextRevisionDate        DateTime? @db.Date
  nextRevisionMileage     Int?
  notes                   String?  @db.Text
  createdById             String?
  createdBy               User?    @relation("VehicleRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById             String?
  updatedBy               User?    @relation("VehicleRevisionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([vehicleId, revisionDate])
  @@index([createdById])
}

model VehicleUsage {
  id             String   @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  usedBy         String   @db.VarChar(120)
  destination    String   @db.VarChar(180)
  usageDate      DateTime @db.Date
  startMileage   Int
  endMileage     Int
  fuelAmount     Decimal? @db.Decimal(10, 2)
  fuelCost       Decimal? @db.Decimal(10, 2)
  notes          String?  @db.Text
  createdById    String?
  createdBy      User?    @relation("VehicleUsageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      User?    @relation("VehicleUsageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([vehicleId, usageDate])
  @@index([createdById])
}
